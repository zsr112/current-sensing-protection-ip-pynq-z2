    "sticky_status_supported": false,
    "sticky_clear_semantics": null,
    "snapshot_consistency": "SEQUENCE_CHANNELS_FLAGS_SEQUENCE_RETRY_UNTIL_SEQUENCE_MATCHES",
    "field_and_offset_freeze_owner": "STAGE2H_SINGLE_SOURCE_REGISTER_GENERATION"
  },
  "parameters": [
    {
      "parameter": "raw_width",
      "authority": "SYNTHESIS_TIME",
      "authority_artifact": "spec/stage2f_adc_fact_inventory.json",
      "target_value": 12,
      "status": "REPOSITORY_FACT",
      "rationale": "The production register and interface contract is fixed at 12 raw bits."
    },
    {
      "parameter": "source_profile_state",
      "authority": "SOURCE_PROFILE",
      "authority_artifact": "spec/stage2f_adc_source_profile_unconfigured.json",
      "target_value": "UNCONFIGURED",
      "status": "EXTERNAL_HARDWARE_UNKNOWN",
      "rationale": "Absence of an approved source profile never selects a plausible default."
    },
    {
      "parameter": "encoding",
      "authority": "SOURCE_PROFILE",
      "authority_artifact": "spec/stage2f_adc_source_profile.schema.json",
      "target_value": "UNKNOWN",
      "status": "EXTERNAL_HARDWARE_UNKNOWN",
      "rationale": "A configured profile selects UNSIGNED_WITH_ZERO_CODE or TWOS_COMPLEMENT."
    },
    {
      "parameter": "zero_code",
      "authority": "SOURCE_PROFILE",
      "authority_artifact": "spec/stage2f_adc_source_profile.schema.json",
      "target_value": null,
      "status": "EXTERNAL_HARDWARE_UNKNOWN",
      "rationale": "The nominal zero is explicit for unsigned coding and zero for two's complement."
    },
    {
      "parameter": "channel_polarity",
      "authority": "SOURCE_PROFILE",
      "authority_artifact": "spec/stage2f_adc_source_profile.schema.json",
      "target_value": "UNKNOWN",
      "status": "EXTERNAL_HARDWARE_UNKNOWN",
      "rationale": "Each channel explicitly maps increasing code to positive or negative current direction."
    },
    {
      "parameter": "normalized_width",
      "authority": "SYNTHESIS_TIME",
      "authority_artifact": "docs/architecture/stage2f_adc_encoding_scaling_target_contract.md",
      "target_value": 13,
      "status": "DESIGN_DECISION",
      "rationale": "All supported 12-bit decode and polarity results fit exactly in a signed 13-bit code count."
    },
    {
      "parameter": "normalized_unit",
      "authority": "SYNTHESIS_TIME",
      "authority_artifact": "docs/architecture/stage2f_adc_encoding_scaling_target_contract.md",
      "target_value": "SIGNED_CODE_COUNT",
      "status": "DESIGN_DECISION",
      "rationale": "The digital foundation makes no physical-unit claim."
    },
    {
      "parameter": "pipeline_latency",
      "authority": "IMPLEMENTATION_DERIVED",
      "authority_artifact": "FUTURE_SCALE_CAPABILITY_METADATA",
      "target_value": "IMPLEMENTATION_DERIVED_FIXED_CONSTANT",
      "status": "DESIGN_DECISION",
      "rationale": "The exact constant follows arithmetic selection and timing work; consumers use valid and sequence."
    },
    {
      "parameter": "pipeline_initiation_interval",
      "authority": "SYNTHESIS_TIME",
      "authority_artifact": "docs/architecture/stage2f_adc_encoding_scaling_target_contract.md",
      "target_value": 1,
      "status": "DESIGN_DECISION",
      "rationale": "The no-ready input must accept every accepted atomic destination delivery without backpressure or drop."
    },
    {
      "parameter": "configuration_identity",
      "authority": "SOURCE_PROFILE",
      "authority_artifact": "spec/stage2f_adc_source_profile_unconfigured.json",
      "target_value": "UNCONFIGURED",
      "status": "DESIGN_DECISION",
      "rationale": "Telemetry identifies the exact validated digital source profile."
    },
    {
      "parameter": "physical_unit_scale",
      "authority": "NOT_SUPPORTED",
      "authority_artifact": "spec/stage2f_closure_boundary.json",
      "target_value": "NONE",
      "status": "OUT_OF_SCOPE",
      "rationale": "Code-to-current scaling remains blocked on approved hardware and calibration authorities."
    },
    {
      "parameter": "board_calibration_arithmetic",
      "authority": "DEFERRED",
      "authority_artifact": "spec/stage2f_closure_boundary.json",
      "target_value": "DEFERRED",
      "status": "BOARD_CALIBRATION_REQUIRED",
      "rationale": "Per-channel measured offset and gain arithmetic is not part of the initial digital foundation."
    },
    {
      "parameter": "generic_rational_divider",
      "authority": "NOT_SUPPORTED",
      "authority_artifact": "docs/architecture/stage2f_adc_encoding_scaling_tradeoff.md",
      "target_value": false,
      "status": "OUT_OF_SCOPE",
      "rationale": "No current requirement or authority justifies a generic signed divider."
    },
    {
      "parameter": "overcurrent_thresholds",
      "authority": "RUNTIME_SOFTWARE",
      "authority_artifact": "EXISTING_TH_OC1_AND_TH_OC2_REGISTERS",
      "target_value": "EXISTING_12_BIT_VALUES",
      "status": "REPOSITORY_FACT",
      "rationale": "Existing thresholds retain unsigned raw-code semantics."
    },
    {
      "parameter": "difference_threshold",
      "authority": "RUNTIME_SOFTWARE",
      "authority_artifact": "EXISTING_TH_DIFF_REGISTER",
      "target_value": "EXISTING_12_BIT_VALUE",
      "status": "REPOSITORY_FACT",
      "rationale": "The difference threshold retains unsigned raw-code-difference semantics."
    },
    {
      "parameter": "normalized_protection_thresholds",
      "authority": "NOT_SUPPORTED",
      "authority_artifact": "NONE_IN_STAGE2F_COMPATIBILITY_ARCHITECTURE",
      "target_value": "NONE",
      "status": "OUT_OF_SCOPE",
      "rationale": "A normalized protection domain requires a future versioned safety contract."
    },
    {
      "parameter": "runtime_scaling_writes",
      "authority": "NOT_SUPPORTED",
      "authority_artifact": "NONE_IN_STAGE2F_DIGITAL_FOUNDATION",
      "target_value": "NONE",
      "status": "OUT_OF_SCOPE",
      "rationale": "Static source meaning is not made AXI-writable for generality."
    },
    {
      "parameter": "configuration_valid",
      "authority": "SOURCE_PROFILE",
      "authority_artifact": "spec/stage2f_adc_source_profile_unconfigured.json",
      "target_value": false,
      "status": "DESIGN_DECISION",
      "rationale": "The current unconfigured profile cannot produce normalized telemetry."
    },
    {
      "parameter": "production_normalized_telemetry",
      "authority": "SOURCE_PROFILE",
      "authority_artifact": "spec/stage2f_adc_source_profile_unconfigured.json",
      "target_value": "UNAVAILABLE_UNCONFIGURED",
      "status": "DESIGN_DECISION",
      "rationale": "Raw protection remains active while normalized output is unavailable."
    }
  ]
}
