[Unit]
Description=Load and verify the current sensing protection FPGA release
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/local/libexec/current-sensing-protection-ip/load_current_release_once.sh
TimeoutStartSec=120s
KillMode=mixed
Restart=no

[Install]
WantedBy=multi-user.target
