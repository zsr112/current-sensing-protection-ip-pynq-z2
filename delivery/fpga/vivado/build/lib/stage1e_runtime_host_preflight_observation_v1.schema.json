{
  "$schema": "stage1e-schema-subset-v1",
  "$id": "stage1e-runtime-host-preflight-observation-v1",
  "title": "Stage 1E host preflight observation foundation v1",
  "type": "object",
  "required": [
    "schema_version",
    "observation_scope",
    "observation_state",
    "request_identity",
    "execution_id",
    "attempt_id",
    "platform",
    "os_version",
    "process_architecture",
    "powershell_version",
    "clr_version",
    "process_provider_interface",
    "containment_capability",
    "monotonic_clock_capability",
    "executable_requested_path",
    "executable_final_path",
    "executable_file_state",
    "cwd_requested_path",
    "cwd_final_path",
    "cwd_directory_state",
    "evidence_requested_path",
    "evidence_final_path",
    "evidence_directory_state",
    "path_reparse_state",
    "advanced_path_hardening_state",
    "root_separation_state",
    "environment_projection_state",
    "repository_runtime_output_state",
    "conflicts",
    "authority_boundary"
  ],
  "additionalProperties": false,
  "x-stage1e-canonical-order": [
    "schema_version",
    "observation_scope",
    "observation_state",
    "request_identity",
    "execution_id",
    "attempt_id",
    "platform",
    "os_version",
    "process_architecture",
    "powershell_version",
    "clr_version",
    "process_provider_interface",
    "containment_capability",
    "monotonic_clock_capability",
    "executable_requested_path",
    "executable_final_path",
    "executable_file_state",
    "cwd_requested_path",
    "cwd_final_path",
    "cwd_directory_state",
    "evidence_requested_path",
    "evidence_final_path",
    "evidence_directory_state",
    "path_reparse_state",
    "advanced_path_hardening_state",
    "root_separation_state",
    "environment_projection_state",
    "repository_runtime_output_state",
    "conflicts",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "stage1e-runtime-host-preflight-observation-v1"},
    "observation_scope": {"type": "string", "const": "FOUNDATION_NON_QUALIFYING"},
    "observation_state": {"type": "string", "enum": ["READY", "BLOCKED", "UNAVAILABLE"]},
    "request_identity": {"$ref": "stage1e-runtime-host-common-v1#/$defs/sha256"},
    "execution_id": {"$ref": "stage1e-runtime-host-common-v1#/$defs/token"},
    "attempt_id": {"$ref": "stage1e-runtime-host-common-v1#/$defs/token"},
    "platform": {"type": "string", "const": "WINDOWS"},
    "os_version": {"$ref": "stage1e-runtime-host-common-v1#/$defs/token"},
    "process_architecture": {"type": "string", "enum": ["X64", "X86", "ARM64", "UNKNOWN"]},
    "powershell_version": {"$ref": "stage1e-runtime-host-common-v1#/$defs/token"},
    "clr_version": {"$ref": "stage1e-runtime-host-common-v1#/$defs/token"},
    "process_provider_interface": {"type": "string", "const": "stage1e-windows-process-control-interface-v1"},
    "containment_capability": {"type": "string", "enum": ["AVAILABLE", "UNAVAILABLE"]},
    "monotonic_clock_capability": {"type": "string", "enum": ["AVAILABLE", "UNAVAILABLE"]},
    "executable_requested_path": {"$ref": "stage1e-runtime-host-common-v1#/$defs/path"},
    "executable_final_path": {"$ref": "stage1e-runtime-host-common-v1#/$defs/path_or_none"},
    "executable_file_state": {"type": "string", "enum": ["PRESENT", "MISSING", "WRONG_TYPE", "UNAVAILABLE"]},
    "cwd_requested_path": {"$ref": "stage1e-runtime-host-common-v1#/$defs/path"},
    "cwd_final_path": {"$ref": "stage1e-runtime-host-common-v1#/$defs/path_or_none"},
    "cwd_directory_state": {"type": "string", "enum": ["PRESENT", "MISSING", "WRONG_TYPE", "UNAVAILABLE"]},
    "evidence_requested_path": {"$ref": "stage1e-runtime-host-common-v1#/$defs/path"},
    "evidence_final_path": {"$ref": "stage1e-runtime-host-common-v1#/$defs/path_or_none"},
    "evidence_directory_state": {"type": "string", "enum": ["PRESENT", "MISSING", "WRONG_TYPE", "UNAVAILABLE"]},
    "path_reparse_state": {"type": "string", "enum": ["CLEAR", "DETECTED", "UNKNOWN"]},
    "advanced_path_hardening_state": {"type": "string", "const": "DEFERRED_FUTURE_HOST_CONTRACT"},
    "root_separation_state": {"type": "string", "enum": ["DISJOINT", "OVERLAP", "UNKNOWN"]},
    "environment_projection_state": {"type": "string", "enum": ["EXPLICIT", "INVALID", "UNKNOWN"]},
    "repository_runtime_output_state": {"type": "string", "enum": ["CLEAR", "DETECTED", "UNKNOWN"]},
    "conflicts": {"type": "array", "items": {"$ref": "stage1e-runtime-host-common-v1#/$defs/message"}, "uniqueItems": true, "maxItems": 64},
    "authority_boundary": {"$ref": "stage1e-runtime-host-common-v1#/$defs/authority_boundary"}
  }
}
