{
  "$schema": "stage1e-schema-subset-v1",
  "$id": "stage1e-runtime-host-common-v1",
  "title": "Stage 1E runtime host common definitions v1",
  "$defs": {
    "token": {"type": "string", "minLength": 1, "maxLength": 256, "x-stage1e-format": "token"},
    "message": {"type": "string", "minLength": 1, "maxLength": 2048, "x-stage1e-format": "message"},
    "argument": {"type": "string", "maxLength": 4096, "x-stage1e-format": "message"},
    "path": {"type": "string", "minLength": 3, "maxLength": 4096, "x-stage1e-format": "canonical-absolute-path"},
    "sha256": {"type": "string", "x-stage1e-format": "sha256"},
    "path_or_none": {
      "oneOf": [
        {"type": "string", "const": "NONE"},
        {"$ref": "#/$defs/path"}
      ]
    },
    "pid_or_unavailable": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 4294967295},
        {"type": "string", "const": "UNAVAILABLE"}
      ]
    },
    "integer_or_unavailable": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        {"type": "string", "enum": ["UNAVAILABLE", "STILL_ACTIVE"]}
      ]
    },
    "ordinal_or_none": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 2147483647},
        {"type": "string", "const": "NONE"}
      ]
    },
    "failure_or_none": {
      "oneOf": [
        {"type": "string", "const": "NONE"},
        {"$ref": "stage1e-runtime-failure-record-v1#/$defs/failure_record"}
      ]
    },
    "authority_boundary": {
      "type": "object",
      "required": [
        "qualification_decision",
        "authorization_issue",
        "authorization_consumption",
        "engineering_acceptance",
        "bitstream_xsa_generation",
        "artifact_collection",
        "publication",
        "hardware_manager",
        "board_access"
      ],
      "additionalProperties": false,
      "x-stage1e-canonical-order": [
        "qualification_decision",
        "authorization_issue",
        "authorization_consumption",
        "engineering_acceptance",
        "bitstream_xsa_generation",
        "artifact_collection",
        "publication",
        "hardware_manager",
        "board_access"
      ],
      "properties": {
        "qualification_decision": {"type": "string", "const": "NONE"},
        "authorization_issue": {"type": "string", "const": "NONE"},
        "authorization_consumption": {"type": "string", "const": "NOT_OWNED"},
        "engineering_acceptance": {"type": "string", "const": "NONE"},
        "bitstream_xsa_generation": {"type": "string", "const": "NONE"},
        "artifact_collection": {"type": "string", "const": "NONE"},
        "publication": {"type": "string", "const": "NONE"},
        "hardware_manager": {"type": "string", "const": "NONE"},
        "board_access": {"type": "string", "const": "NONE"}
      }
    },
    "evidence_file": {
      "type": "object",
      "required": ["status", "path", "byte_count"],
      "additionalProperties": false,
      "x-stage1e-canonical-order": ["status", "path", "byte_count"],
      "properties": {
        "status": {"type": "string", "enum": ["PRESENT", "MISSING", "PARTIAL", "UNAVAILABLE"]},
        "path": {"$ref": "#/$defs/path_or_none"},
        "byte_count": {"$ref": "#/$defs/integer_or_unavailable"}
      }
    },
    "environment_entry": {
      "type": "object",
      "required": ["name", "value", "source", "sensitive"],
      "additionalProperties": false,
      "x-stage1e-canonical-order": ["name", "value", "source", "sensitive"],
      "properties": {
        "name": {"$ref": "#/$defs/token"},
        "value": {"type": "string", "maxLength": 4096, "x-stage1e-format": "message"},
        "source": {"type": "string", "enum": ["PARENT_EXACT", "REQUEST_TEMPORARY_ROOT", "REQUEST_CACHE_ROOT", "REQUEST_ENCODING", "REQUEST_LOCALE", "REQUEST_TIME_ZONE"]},
        "sensitive": {"type": "boolean"}
      }
    }
  }
}
