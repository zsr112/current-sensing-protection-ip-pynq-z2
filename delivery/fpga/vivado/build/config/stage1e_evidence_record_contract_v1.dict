records {
    evidence_authority_boundary {
        owner CONTRACT
        fields {
            qualification_decision authorization_issue
            authorization_consumption engineering_acceptance
            implementation_result_candidate artifact publication
            hardware_manager board_access
        }
        types {
            qualification_decision string authorization_issue string
            authorization_consumption string engineering_acceptance string
            implementation_result_candidate string artifact string
            publication string hardware_manager string board_access string
        }
    }
    content_integrity_observation {
