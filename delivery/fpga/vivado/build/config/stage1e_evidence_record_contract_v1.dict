            schema_version string request_identity string execution_id string
            attempt_id string workspace_identity string
            evidence_set_reference record:sealed_evidence_reference
            completeness_state string
            blocking_roles string_list issue_references string_list
            structural_only string candidate_effect string
            authority_boundary record:evidence_authority_boundary
        }
    }
    evidence_structural_review_result {
        owner EVIDENCE_CONTROLLER
        fields {
            schema_version request_identity execution_id attempt_id
            workspace_identity review_state terminal_status
            failure_category failure_code failure_phase
            request_provenance_state host_result_state
            operation_ledger_state phys_opt_prohibition_state
            collector_ledger_state parser_inventory_state
            role_completeness_state projection_agreement_state
            failure_order_state forbidden_scan_state authority_state
            first_failure_reference secondary_failure_references
            candidate_effect policy_review_state identity_state
            authority_boundary
        }
        types {
            schema_version string request_identity string execution_id string
            attempt_id string workspace_identity string review_state string
            terminal_status string failure_category string
            failure_code string failure_phase string
            request_provenance_state string host_result_state string
            operation_ledger_state string phys_opt_prohibition_state string
            collector_ledger_state string parser_inventory_state string
            role_completeness_state string projection_agreement_state string
            failure_order_state string forbidden_scan_state string
            authority_state string first_failure_reference string
            secondary_failure_references string_list candidate_effect string
            policy_review_state string identity_state string
            authority_boundary record:evidence_authority_boundary
        }
    }
}
enums {
    collector_entry_modes {ROUTED_REPORTING FAILURE_EVIDENCE_ONLY}
    report_attempt_states {
        NOT_ATTEMPTED STARTED COLLECTED FAILED MISSING BLOCKED
        UNAVAILABLE_FOR_STATE INTERRUPTED
    }
    parser_terminal_states {
        COMPLETE PARTIAL UNSUPPORTED_FORMAT CONFLICT TRUNCATED_INPUT
        UNKNOWN_IDENTIFIER UNKNOWN_NUMERIC
    }
    evidence_states {
        PRESENT MISSING FAILED BLOCKED INTERRUPTED UNAVAILABLE_FOR_STATE
        FOREIGN_EXECUTION UNSUPPORTED_FORMAT CONFLICT NOT_REQUIRED
    }
    identity_states {PENDING_IDENTITY_PROVIDER UNAVAILABLE_WITH_REASON}
    condition_states {REQUIRED NOT_REQUIRED CONDITION_UNKNOWN NOT_APPLICABLE}
    foreign_states {CURRENT FOREIGN HISTORICAL FIXTURE_ONLY}
    byte_states {PRESENT ZERO_BYTE MISSING UNAVAILABLE}
    integrity_states {VERIFIED_SHA256 UNAVAILABLE_WITH_REASON NOT_APPLICABLE}
    reference_location_states {FILE EXPLICIT_DISCONNECTED STRUCTURAL_NON_FILE}
    reference_availability_states {
        PRESENT DISCONNECTED_EXPLICIT UNAVAILABLE_WITH_REASON
    }
    numeric_value_states {PRESENT UNKNOWN}
    completeness_states {COMPLETE PARTIAL UNAVAILABLE}
    projection_states {MATCH MISMATCH}
    structural_review_states {
        EVIDENCE_STRUCTURAL_REVIEW_COMPLETE EVIDENCE_INCOMPLETE
        COLLECTOR_BLOCKED PARSER_BLOCKED
    }
}
policy_stop {
    terminal_status BLOCKED failure_category POLICY_REVIEW
    failure_code PRODUCTION_POLICY_REVIEW_NOT_IMPLEMENTED
    failure_phase REVIEW candidate_effect NOT_CREATED
    review_state EVIDENCE_STRUCTURAL_REVIEW_COMPLETE
}
