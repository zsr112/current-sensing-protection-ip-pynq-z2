    required_gate_status PASS
    required_decision PASS
    evidence_required_fields {
        schema_version
        identity_sha256
        execution_id
        source_identity
        plan_contract_identity
        capability_identity
        workspace_qualification_identity
        workspace_identity
        synthesis_result_identity
        evidence_plan_identity
        authorization_preparation_identity
        gate_evidence
        retry_guard_identity
        decision
