    qualification_evidence_schema stage1e-phase3-runtime-qualification-evidence-identity-v1
    gate_order {Q0 Q1 Q2 Q3 Q4 Q5}
    gates {
        Q0 PLAN_AND_CONTRACT_REVIEW
        Q1 SOURCE_FREEZE
        Q2 VIVADO_CAPABILITY_QUALIFICATION
        Q3 WORKSPACE_ACCEPTANCE
        Q4 SYNTHESIS_PREDECESSOR_ACCEPTANCE
        Q5 IMPLEMENTATION_AUTHORIZATION_PREPARATION
