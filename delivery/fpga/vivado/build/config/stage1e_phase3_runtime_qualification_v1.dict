        execution_id
        source_identity
        plan_contract_identity
        capability_identity
        workspace_qualification_identity
        workspace_identity
        synthesis_result_identity
        evidence_plan_identity
        authorization_preparation_identity
        gate_evidence
        retry_guard_identity
        decision
    }
    missing_action BLOCK
    stale_action BLOCK
    mismatch_action BLOCK
    unknown_action BLOCK
}
capability_probe_contract {
    schema_version stage1e-vivado-implementation-capability-observation-v1
    probe_mode OBSERVATION_ONLY
    probe_order {
        opt_design
        place_design
        route_design
        implementation_reports
        timing_reports
        drc_reports
        methodology_reports
    }
    probes {
        opt_design {
            discovery_commands {opt_design}
            required_status PASS
            mutation_allowed 0
        }
        place_design {
            discovery_commands {place_design}
            required_status PASS
            mutation_allowed 0
        }
        route_design {
            discovery_commands {route_design}
            required_status PASS
            mutation_allowed 0
        }
        implementation_reports {
            discovery_commands {report_route_status report_utilization}
            required_status PASS
            mutation_allowed 0
        }
        timing_reports {
            discovery_commands {
                report_timing_summary
                report_clock_interaction
                report_exceptions
            }
            required_status PASS
            mutation_allowed 0
        }
        drc_reports {
            discovery_commands {report_drc}
            required_status PASS
            mutation_allowed 0
        }
        methodology_reports {
            discovery_commands {report_methodology report_cdc}
            required_status PASS
            mutation_allowed 0
        }
    }
    required_fields {
        schema_version
        identity_sha256
        execution_id
        probe_mode
        vivado_identity
        part
        board_part
        license_capability
        run_capability
        probe_results
        evidence_identity
        decision
    }
    identity_fields {
        schema_version
        execution_id
        probe_mode
        vivado_identity
        part
        board_part
        license_capability
        run_capability
        probe_results
        evidence_identity
        decision
    }
    vivado_identity_contract {
        schema_version stage1e-vivado-identity-v1
        required_fields {
            schema_version
            vivado_version
            software_build
            ip_build
            executable_identity
            evidence_identity
        }
    }
    license_contract {
        schema_version stage1e-implementation-license-capability-v1
        required_fields {
            schema_version
            status
            implementation_feature_available
            evidence_identity
        }
        required_status PASS
        required_feature_state 1
    }
    run_contract {
        schema_version stage1e-implementation-run-capability-v1
        required_fields {
            schema_version
            status
            run_name
            command_availability
            mutation_performed
            evidence_identity
        }
        required_commands {
            get_runs
            create_run
            launch_runs
            wait_on_run
            open_run
            reset_run
            report_generation
        }
        required_status PASS
        mutation_performed 0
    }
    missing_probe_action BLOCK
    unavailable_command_action BLOCK
    license_failure_action BLOCK
    target_mismatch_action BLOCK
    unknown_action BLOCK
}
