schema_version stage1e-vivado-runtime-property-map-v1
contract_state VIVADO_2024_1_QUALIFICATION_REQUIRED
vivado_version 2024.1
snapshot_points {
    TOOL_PREFLIGHT PRE_CONSUME POST_OPT POST_PLACE POST_ROUTE TERMINAL
}
object_selectors {
    CURRENT_PROJECT {
        query_role CURRENT_PROJECT expected_cardinality 1
        unavailable_action BLOCK
    }
    SOURCES_FILESET {
        query_role SOURCES_FILESET expected_cardinality 1
        unavailable_action BLOCK
    }
    IMPL_RUN {
        query_role IMPL_RUN expected_cardinality 1 unavailable_action BLOCK
