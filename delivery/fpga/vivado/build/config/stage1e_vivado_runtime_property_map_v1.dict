graph_bindings {
    opt_design {
        enabled OPT_ENABLED directive OPT_DIRECTIVE status OPT_STATUS
        pre_hook OPT_PRE_HOOK post_hook OPT_POST_HOOK
    }
    place_design {
        enabled PLACE_ENABLED directive PLACE_DIRECTIVE status PLACE_STATUS
        pre_hook PLACE_PRE_HOOK post_hook PLACE_POST_HOOK
    }
    phys_opt_design {
        enabled PHYS_OPT_ENABLED directive PHYS_OPT_DIRECTIVE
        status PHYS_OPT_STATUS pre_hook PHYS_OPT_PRE_HOOK
        post_hook PHYS_OPT_POST_HOOK
    }
    route_design {
        enabled ROUTE_ENABLED directive ROUTE_DIRECTIVE status ROUTE_STATUS
        pre_hook ROUTE_PRE_HOOK post_hook ROUTE_POST_HOOK
    }
}
qualification_boundary {
    alias_probe_policy PROHIBITED
    unavailable_action BLOCK
    unknown_action BLOCK
    ambiguous_action BLOCK
    conflicting_action BLOCK
    actual_vivado_readback VIVADO_2024_1_QUALIFICATION_REQUIRED
}
