{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://current-sensing-protection-ip.local/spec/register_map.schema.json",
  "title": "Current-sensing protection IP public register map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "abi",
    "generated_artifacts",
    "parameters",
    "bus_behavior",
    "fault_codes",
    "fault_causes",
    "abi_1_1_contract",
    "registers"
  ],
  "properties": {
    "$schema": {
      "const": "register_map.schema.json"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "abi": {
      "$ref": "#/$defs/abi"
    },
    "generated_artifacts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "bus_behavior": {
      "$ref": "#/$defs/bus_behavior"
    },
    "fault_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fault_code"
      }
    },
    "fault_causes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/fault_cause"
      }
    },
    "abi_1_1_contract": {
      "$ref": "#/$defs/abi_1_1_contract"
    },
    "registers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/register"
      }
    }
  },
  "$defs": {
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "data_width",
        "address_width",
        "byte_order",
        "legacy_address_range"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "data_width": {
          "const": 32
        },
        "address_width": {
          "const": 8
        },
        "byte_order": {
          "const": "little"
        },
        "legacy_address_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first", "last"],
          "properties": {
            "first": {
              "$ref": "#/$defs/uint"
            },
            "last": {
              "$ref": "#/$defs/uint"
            }
          }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "minimum", "maximum", "default", "description"],
      "properties": {
        "name": {
          "$ref": "#/$defs/upper_name"
        },
        "minimum": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": "integer",
          "minimum": 0
        },
        "default": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "$ref": "#/$defs/description"
        }
      }
    },
    "bus_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address_decode",
        "accepted_write",
        "undefined_read",
        "undefined_write",
        "read_data",
        "current_monitor_pair"
      ],
      "properties": {
        "address_decode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lsb", "msb", "outer_address_aliases"],
          "properties": {
            "lsb": {
              "const": 0
            },
            "msb": {
              "const": 7
            },
            "outer_address_aliases": {
              "type": "boolean"
            }
          }
        },
        "accepted_write": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requires_any_wstrb", "legacy_unstrobed_registers"],
          "properties": {
            "requires_any_wstrb": {
              "type": "boolean"
            },
            "legacy_unstrobed_registers": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/upper_name"
              }
            }
          }
        },
        "undefined_read": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "response"],
          "properties": {
            "value": {
              "$ref": "#/$defs/uint"
            },
            "response": {
              "const": "OKAY"
            }
          }
        },
        "undefined_write": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effect", "response"],
          "properties": {
            "effect": {
              "const": "NONE"
            },
            "response": {
              "const": "OKAY"
            }
          }
        },
        "read_data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["combinational_decode", "rd_en_gates_value"],
          "properties": {
            "combinational_decode": {
              "type": "boolean"
            },
            "rd_en_gates_value": {
              "type": "boolean"
            }
          }
        },
        "current_monitor_pair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hardware_delivery_atomic",
            "software_reads_atomic",
            "description"
          ],
          "properties": {
            "hardware_delivery_atomic": {
              "type": "boolean"
            },
            "software_reads_atomic": {
              "type": "boolean"
            },
            "description": {
              "$ref": "#/$defs/description"
            }
          }
        }
      }
    },
    "fault_code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "description",
        "public_names",
        "legacy_aliases"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/upper_name"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "public_names": {
          "$ref": "#/$defs/public_names"
        },
        "legacy_aliases": {
          "$ref": "#/$defs/legacy_aliases"
        }
      }
    },
    "fault_cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bit", "description", "public_names"],
      "properties": {
        "name": {
          "$ref": "#/$defs/upper_name"
        },
        "bit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "public_names": {
          "$ref": "#/$defs/public_names"
        }
      }
    },
    "abi_1_1_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_enable_parameter",
        "rtl_sources",
        "capabilities",
        "api_gates",
        "metadata_constraints",
        "invariants",
        "conformance_templates",
        "conformance_routes",
        "fault_projection",
        "fault_forward_compatibility",
        "policy_identity"
      ],
      "properties": {
        "explicit_enable_parameter": {
          "const": "EXPLICIT_ABI_1_1"
        },
        "rtl_sources": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/$defs/rtl_source"
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "api_gates": {
          "type": "array",
          "minItems": 9,
          "items": {
            "$ref": "#/$defs/api_gate"
          }
        },
        "metadata_constraints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/upper_name"
          }
        },
        "invariants": {
          "type": "array",
          "minItems": 8,
          "items": {
            "$ref": "#/$defs/invariant"
          }
        },
        "conformance_templates": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/conformance_template"
          }
        },
        "conformance_routes": {
          "type": "array",
          "minItems": 7,
          "items": {
            "$ref": "#/$defs/conformance_route"
          }
        },
        "fault_projection": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/fault_projection_rule"
          }
        },
        "fault_forward_compatibility": {
          "$ref": "#/$defs/fault_forward_compatibility"
        },
        "policy_identity": {
          "$ref": "#/$defs/policy_identity"
        }
      }
    },
    "rtl_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "module",
        "signal",
        "width",
        "clock_domain",
        "reset_domain"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/upper_name"},
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"
        },
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "signal": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "width": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 32},
            {"$ref": "#/$defs/upper_name"}
          ]
        },
        "clock_domain": {"$ref": "#/$defs/upper_name"},
        "reset_domain": {"$ref": "#/$defs/upper_name"},
        "state_encodings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ST_ARMED", "ST_FAULT_LATCHED", "ST_RESET_WAIT"],
          "properties": {
            "ST_ARMED": {"type": "integer", "minimum": 0, "maximum": 15},
            "ST_FAULT_LATCHED": {"type": "integer", "minimum": 0, "maximum": 15},
            "ST_RESET_WAIT": {"type": "integer", "minimum": 0, "maximum": 15}
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "bit",
        "field_ref",
        "advertised",
        "required_edges",
        "required_api_gates",
        "required_metadata_constraints"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/upper_name"},
        "bit": {"type": "integer", "minimum": 0, "maximum": 6},
        "field_ref": {"$ref": "#/$defs/field_ref"},
        "advertised": {"type": "boolean"},
        "required_edges": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/dependency_edge"}
        },
        "required_api_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/upper_name"}
        },
        "required_metadata_constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/upper_name"}
        }
      }
    },
    "dependency_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "rtl_binding_id", "conformance_family"],
      "properties": {
        "target": {"$ref": "#/$defs/field_ref"},
        "rtl_binding_id": {"$ref": "#/$defs/upper_name"},
        "conformance_family": {"$ref": "#/$defs/upper_name"}
      }
    },
    "api_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "features"],
      "properties": {
        "id": {"$ref": "#/$defs/upper_name"},
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/upper_name"}
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "targets", "rule"],
      "properties": {
        "id": {"$ref": "#/$defs/upper_name"},
        "kind": {
          "enum": ["EXACTLY_ONE", "IMPLIES", "MASK_ZERO", "TEMPORAL"]
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rule": {"$ref": "#/$defs/description"}
      }
    },
    "conformance_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "vectors"],
      "properties": {
        "id": {
          "enum": [
            "RO_STATIC",
            "RO_STATE_DECODE",
            "RO_LEVEL",
            "RO_BITMAP",
            "RO_EVENT_CAPTURE",
            "FAULT_PROJECTION",
            "FAULT_FORWARD_COMPATIBILITY"
          ]
        },
        "vectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/upper_name"}
        }
      }
    },
    "conformance_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "templates"],
      "properties": {
        "family": {"$ref": "#/$defs/upper_name"},
        "templates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/upper_name"}
        }
      }
    },
    "fault_projection_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "kind", "causes"],
      "properties": {
        "code": {"$ref": "#/$defs/upper_name"},
        "kind": {
          "enum": ["OVERCURRENT_AND_SENSOR", "ANY_OF", "NONE_OF"]
        },
        "causes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/upper_name"}
        }
      }
    },
    "fault_forward_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_width",
        "minimum_advertised_width",
        "maximum_advertised_width",
        "preserve_unknown_within_width",
        "reject_bits_above_width"
      ],
      "properties": {
        "known_width": {"const": 6},
        "minimum_advertised_width": {"const": 6},
        "maximum_advertised_width": {"const": 32},
        "preserve_unknown_within_width": {"const": true},
        "reject_bits_above_width": {"const": true}
      }
    },
    "policy_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_source_ref",
        "valid_source_ref",
        "destination_width",
        "capture_clean",
        "capture_nonclean",
        "hold_when_invalid",
        "reset",
        "transform",
        "snapshot_token"
      ],
      "properties": {
        "data_source_ref": {"const": "SRC_FAULT_EVAL_SEQUENCE"},
        "valid_source_ref": {"const": "SRC_FAULT_EVAL_VALID"},
        "destination_width": {"const": 32},
        "capture_clean": {"const": true},
        "capture_nonclean": {"const": true},
        "hold_when_invalid": {"const": true},
        "reset": {"const": 0},
        "transform": {"const": "ZERO_EXTEND"},
        "snapshot_token": {"const": false}
      }
    },
    "register": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "offset",
        "width",
        "access",
        "value_kind",
        "reset",
        "write_strobe",
        "description",
        "public_names",
        "fields"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/upper_name"
        },
        "offset": {
          "$ref": "#/$defs/uint"
        },
        "width": {
          "const": 32
        },
        "access": {
          "enum": ["RO", "RW", "RW/W1P", "RO/W1C"]
        },
        "value_kind": {
          "enum": ["stored", "dynamic", "static", "parameterized_static"]
        },
        "reset": {
          "$ref": "#/$defs/uint"
        },
        "write_strobe": {
          "enum": [
            "NOT_APPLICABLE",
            "IGNORED_AFTER_ACCEPTED_WRITE",
            "BYTE_QUALIFIED"
          ]
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "public_names": {
          "$ref": "#/$defs/public_names"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "lsb",
        "msb",
        "access",
        "reset",
        "description",
        "read_behavior",
        "write_behavior",
        "public_names"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "lsb": {
          "type": "integer",
          "minimum": 0
        },
        "msb": {
          "type": "integer",
          "minimum": 0
        },
        "access": {
          "enum": ["RO", "RW", "W1C", "W1P", "RSVD"]
        },
        "reset": {
          "$ref": "#/$defs/uint"
        },
        "parameter_ref": {
          "$ref": "#/$defs/upper_name"
        },
        "enum_ref": {
          "const": "fault_codes"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "read_behavior": {
          "$ref": "#/$defs/description"
        },
        "write_behavior": {
          "$ref": "#/$defs/description"
        },
        "public_names": {
          "$ref": "#/$defs/public_names"
        },
        "behavior_id": {
          "enum": [
            "RO_STATIC",
            "RO_STATE_DECODE",
            "RO_LEVEL",
            "RO_BITMAP",
            "RO_EVENT_CAPTURE",
            "RSVD_ZERO_IGNORE"
          ]
        },
        "rtl_binding_id": {
          "$ref": "#/$defs/upper_name"
        },
        "capability_gate_ref": {
          "$ref": "#/$defs/upper_name"
        },
        "conformance_family": {
          "$ref": "#/$defs/upper_name"
        },
        "static_value": {
          "oneOf": [
            {"$ref": "#/$defs/uint"},
            {"$ref": "#/$defs/parameter_expression"}
          ]
        },
        "dynamic_source": {
          "$ref": "#/$defs/dynamic_source"
        }
      }
    },
    "dynamic_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_ref", "transform"],
      "properties": {
        "kind": {
          "enum": ["STATE_EQUALS", "SIGNAL", "BITMAP_BIT", "EVENT_CAPTURE"]
        },
        "source_ref": {"$ref": "#/$defs/upper_name"},
        "transform": {"enum": ["BOOLEAN_COMPARE", "IDENTITY", "MASK_AND_SELECT", "ZERO_EXTEND"]},
        "state_ref": {"$ref": "#/$defs/upper_name"},
        "source_bit": {"type": "integer", "minimum": 0, "maximum": 31},
        "mask": {"$ref": "#/$defs/uint"},
        "valid_source_ref": {"$ref": "#/$defs/upper_name"}
      }
    },
    "parameter_expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_ref"],
      "properties": {
        "parameter_ref": {"$ref": "#/$defs/upper_name"}
      }
    },
    "field_ref": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Za-z][A-Za-z0-9_]*$"
    },
    "public_names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rtl", "c", "python", "systemverilog", "ipxact", "documentation"],
      "properties": {
        "rtl": {
          "$ref": "#/$defs/upper_name"
        },
        "c": {
          "$ref": "#/$defs/upper_name"
        },
        "python": {
          "$ref": "#/$defs/upper_name"
        },
        "systemverilog": {
          "$ref": "#/$defs/upper_name"
        },
        "ipxact": {
          "$ref": "#/$defs/upper_name"
        },
        "documentation": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        }
      }
    },
    "legacy_aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rtl", "c", "python", "systemverilog"],
      "properties": {
        "rtl": {
          "$ref": "#/$defs/name_array"
        },
        "c": {
          "$ref": "#/$defs/name_array"
        },
        "python": {
          "$ref": "#/$defs/name_array"
        },
        "systemverilog": {
          "$ref": "#/$defs/name_array"
        }
      }
    },
    "name_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/upper_name"
      }
    },
    "upper_name": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "uint": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]+$"
        }
      ]
    }
  }
}
