      }
    },
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bitmap_bit", "raw_signal", "current_code", "priority_rank"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "bitmap_bit": {"type": "integer", "minimum": 0, "maximum": 5},
        "raw_signal": {"type": "string", "minLength": 1},
        "current_code": {"type": "string", "pattern": "^0x[0-9A-F]{2}$"},
        "priority_rank": {"type": "integer", "minimum": 1, "maximum": 6}
      }
