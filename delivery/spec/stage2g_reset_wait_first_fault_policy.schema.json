      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "request_source", "request_capture", "request_boundary", "resolution_transaction", "resolution_order_domain", "same_edge_evaluation_order", "delivery_before_request_retire_after_request", "acceptance_condition", "rejection_condition", "pending_after_accept", "pending_after_reject", "clear_pending_no_sample", "repeated_clear_while_pending", "continuous_ii1_progress", "sequence_wrap", "reset_while_pending", "clear_while_any_live_fault", "source_removal_without_clear", "fault_and_clear_same_cycle", "clear_and_reset_same_cycle", "clear_during_reset_wait", "clear_during_armed_without_latch", "clear_rejection_observability", "post_clear_destination_state", "resolution_transaction_reset_wait_role", "successful_clear_starts_new_episode", "post_recovery_fault_can_latch_again", "recovery_qualify_state"],
      "properties": {
        "protocol": {"const": "REQUEST_EVALUATION_FENCED"},
        "request_source": {"type": "string", "minLength": 1},
        "request_capture": {"type": "string", "minLength": 1},
        "request_boundary": {"type": "string", "minLength": 1},
        "resolution_transaction": {"const": "FIRST_FAULT_EVAL_VALID_ON_AN_ACLK_EDGE_STRICTLY_AFTER_REQUEST_CAPTURE"},
        "resolution_order_domain": {"const": "FAULT_EVALUATION_RETIREMENT_ORDER"},
        "same_edge_evaluation_order": {"const": "EVALUATION_RETIRING_ON_REQUEST_EDGE_IS_EARLIER_AND_DOES_NOT_RESOLVE_NEW_REQUEST"},
        "delivery_before_request_retire_after_request": {"const": "RESOLVES_REQUEST_BECAUSE_RETIREMENT_IS_STRICTLY_AFTER_CAPTURE"},
