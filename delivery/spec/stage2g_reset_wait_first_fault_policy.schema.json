        "first_fault_bitmap": {"type": "string", "minLength": 1},
        "live_fault_bitmap": {"type": "string", "minLength": 1},
        "fault_seen_bitmap": {"type": "string", "minLength": 1},
        "nonclean_evaluation_update": {"const": "NO_BITMAP_OR_FIRST_CAUSE_UPDATE"},
        "public_visibility": {"const": "DEFERRED_TO_STAGE2H"}
      }
    },
