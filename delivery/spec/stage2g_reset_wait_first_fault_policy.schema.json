        "rejection_condition": {"const": "CLEAR_PENDING_AND_FAULT_EVAL_VALID_AND_(NONZERO_BITMAP_OR_NONCLEAN_INTEGRITY)"},
        "pending_after_accept": {"const": "CLEAR_PENDING_CLEARS"},
        "pending_after_reject": {"const": "CLEAR_PENDING_CLEARS_NEW_REQUEST_REQUIRED"},
        "clear_pending_no_sample": {"const": "REMAIN_FAULT_LATCHED_SAFE_INDEFINITELY"},
        "repeated_clear_while_pending": {"const": "IDEMPOTENT_COALESCED_NO_DUPLICATE_EPISODE_END"},
        "continuous_ii1_progress": {"const": "REQUEST_RESOLVES_ON_NEXT_RETIREMENT_EDGE_AFTER_CAPTURE"},
        "sequence_wrap": {"const": "NO_SEQUENCE_COMPARISON_IN_FENCE_MODULO_WRAP_PRESERVES_RETIREMENT_ORDER"},
        "reset_while_pending": {"const": "RESET_CLEARS_PENDING_AND_ALL_EPISODE_PIPELINE_STATE"},
        "clear_while_any_live_fault": {"const": "REJECT"},
        "source_removal_without_clear": {"const": "REMAIN_LATCHED"},
        "fault_and_clear_same_cycle": {"const": "FAULT_PRIORITY"},
        "clear_and_reset_same_cycle": {"const": "RESET_PRIORITY"},
        "clear_during_reset_wait": {"const": "REJECT_NO_OP_REMAIN_SAFE"},
        "clear_during_armed_without_latch": {"const": "REJECT_NO_OP"},
