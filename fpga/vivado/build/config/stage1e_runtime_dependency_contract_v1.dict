    CODEC_PROVIDER
    HASH_PROVIDER
    ATOMIC_PUBLICATION_PROVIDER
    CONFIG_READ
    IDENTITY_INPUT
    HOST_CAPABILITY
    VIVADO_CAPABILITY
    RESULT_REFERENCE
    CALLBACK_TARGET
    DOTNET_SOURCE_PROVIDER
    REVIEW_ASSEMBLY_ROOT
    PROVIDER_OBSERVATION
    REVIEW_TOOL_IMPORT
}
direct_role_order {
    ENTRY_POINT
    LAUNCHER
    RUNNER
    COLLECTOR
    PARSER
    IDENTITY_SERIALIZER
    HOST_OBSERVER
    VIVADO_CAPABILITY_OBSERVER
}
subordinate_contract_order {
    RUNTIME_SCHEMA
    HASH_PROVIDER
    CONTROLLER
    ADAPTER
    FRAMEWORK
    REQUEST
    RESULT
    REPORT
    MESSAGE
    HOST
}
child_provider_order {
    CANONICALIZATION_POWERSHELL
    CANONICALIZATION_TCL
    CODEC_POWERSHELL
    CODEC_TCL
    ATOMIC_PUBLICATION_POWERSHELL
    ATOMIC_PUBLICATION_TCL
    HASH_PROVIDER_POWERSHELL
    HASH_PROVIDER_TCL
    WINDOWS_PROCESS_CONTROL
    VIVADO_SESSION_ASSEMBLY
}
process_domain_order {
    HOST_POWERSHELL
    VIVADO_TCL
    HOST_POSTPROCESS_TCL
}
candidate_roots {
    {domain HOST_POWERSHELL roots {ENTRY_POINT LAUNCHER HOST_OBSERVER}}
    {domain VIVADO_TCL roots {VIVADO_SESSION_ASSEMBLY COLLECTOR}}
    {domain HOST_POSTPROCESS_TCL roots {PARSER IDENTITY_SERIALIZER EVIDENCE_CONTROLLER EVIDENCE_ADAPTER}}
}
trace_scenarios {
    HOST_DISCONNECTED_SAFE_LOAD
    VIVADO_DISCONNECTED_SAFE_LOAD
    POSTPROCESS_DISCONNECTED_SAFE_LOAD
}
attempt_states {
    ATTEMPTED
    LOADED
    FAILED
    OPTIONAL_NOT_LOADED
    BLOCKED
    DECLARED
}
comparison_states {
    MATCH
    MISMATCH
    BLOCKED
}
review_candidate_states {
    REVIEW_REQUIRED
    DISCONNECTED_CANDIDATE_CLOSURE_VALIDATED
    STALE
    BLOCKED
}
ledger_types {
    HOST_ASSEMBLY_LEDGER
    VIVADO_ASSEMBLY_LEDGER
    POSTPROCESS_ASSEMBLY_LEDGER
}
ledger_fields {
    role
    source_path
    provider
    interface_version
    domain
    load_ordinal
    attempt_state
    declared_edge
}
path_rules {
    REPOSITORY_RELATIVE
    FORWARD_SLASH
    NO_EMPTY_COMPONENT
    NO_DOT_COMPONENT
    NO_DOT_DOT_COMPONENT
    SAME_SELECTED_REPOSITORY
    GIT_TRACKED_ACCEPTED_INPUT
    DECLARED_UNTRACKED_REVIEW_TOOL_ONLY
    NO_REPARSE_ESCAPE
    NO_ANCESTOR_REPARSE_POINT
    NO_VOLUME_OR_MOUNT_ESCAPE
    NO_CASE_AMBIGUITY
    NO_SHORT_NAME_ALIAS
    STABLE_REPOSITORY_ROOT_IDENTITY
    NO_GENERATED_OR_IGNORED_INPUT
    NO_AMBIENT_LOOKUP
}
non_runtime_classifications {
    TEST_ONLY
    VALIDATOR_ONLY
    DOCUMENTATION_ONLY
    REVIEW_ONLY
    HISTORICAL_EVIDENCE
    HISTORICAL_NON_PRODUCTION
}
prohibited_dependency_classes {
    GENERATED_WORKSPACE
    XIL_CACHE
    CHECKPOINT
    HISTORICAL_RETRY_OUTPUT
    REPORT_AS_EXECUTABLE_SOURCE
