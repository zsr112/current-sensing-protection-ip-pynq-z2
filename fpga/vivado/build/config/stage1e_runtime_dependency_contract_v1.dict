    UNTRACKED_EXECUTABLE_HELPER
    EXTERNAL_SOURCE
    PATH_ESCAPE
    AMBIENT_MODULE_OR_PACKAGE
    UNRESOLVED_DYNAMIC_DEPENDENCY
}
closure_blockers {
    UNDECLARED_SOURCE
    MISSING_SOURCE
