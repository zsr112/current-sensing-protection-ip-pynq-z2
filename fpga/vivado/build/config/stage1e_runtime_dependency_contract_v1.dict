    TRACE_REQUESTER_MISMATCH
    TRACE_PROVIDER_MISMATCH
    TRACE_INTERFACE_MISMATCH
    TRACE_ORDER_MISMATCH
    LEDGER_BINDING_MISMATCH
    LEDGER_INTEGRITY_MISMATCH
}
allowed_foundation_results {
    PRT02-E_RUNTIME_DEPENDENCY_CLOSURE_FOUNDATION_IMPLEMENTED
    DISCONNECTED_CANDIDATE_CLOSURE_VALIDATED
    HASH_PROVIDER_BOOTSTRAP_VALIDATED
    PRE_DISPATCH_LEDGER_VALIDATORS_IMPLEMENTED
}
required_limitations {
    FINAL_PRODUCTION_DEPENDENCY_CLOSURE_NOT_YET_PROVEN
