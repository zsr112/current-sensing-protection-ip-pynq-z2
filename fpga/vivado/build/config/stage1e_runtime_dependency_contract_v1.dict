schema_version stage1e-runtime-dependency-contract-v1
contract_state DISCONNECTED_CANDIDATE_FOUNDATION
node_classes {
    DIRECT_RUNTIME_SOURCE
    SUBORDINATE_SOURCE
    IDENTITY_INPUT
    EXTERNAL_CAPABILITY
    NON_RUNTIME_SOURCE
    REVIEW_TOOL_SOURCE
    PROHIBITED_RUNTIME_INPUT
}
edge_types {
    TCL_SOURCE
    TCL_PACKAGE
    TCL_NAMESPACE_PROVIDER
    POWERSHELL_MODULE
    POWERSHELL_DOT_SOURCE
    EXECUTABLE_REFERENCE
    FILE_READ
