schema_version stage1e-runtime-provider-contract-v1
hash_contract {
    contract_role HASH_PROVIDER
    interface_version stage1e-runtime-sha256-provider-interface-v1
    powershell_provider HASH_PROVIDER_POWERSHELL
    tcl_provider HASH_PROVIDER_TCL
    independent_verifier HOST_POWERSHELL_GET_FILE_HASH_VERIFIER
    text_semantics UTF8_NO_BOM_EXACT_TEXT_BYTES
    raw_semantics EXACT_BINARY_FILE_BYTES
    empty_vector_bootstrap_adapter PUBLIC_E_OWNED_BYTE_ARRAY_ADAPTER_NO_METADATA_MUTATION
    public_empty_byte_adapter HASH_ADAPTER_POWERSHELL
    public_empty_byte_interface stage1e-prt02e-sha256-empty-byte-adapter-interface-v1
    implementation_independence CROSS_LANGUAGE_AND_PLATFORM_VERIFIER_WITH_SHARED_SHA256_BACKEND
    source_check_disposition HISTORICAL_NON_PRODUCTION
}
