    missing_action BLOCK
    mismatch_action BLOCK
}
validation_contract {
    schema_version stage1e-phase3-validation-contract-v1
    required_suites {
        MARKDOWN_STRUCTURE
        TCL_SYNTAX
        CAPABILITY_SCHEMA
        CONTROLLER_CONTRACT
        ADAPTER_CONTRACT
        IDENTITY_BINDING
        FAIL_CLOSED_BEHAVIOR
        PROVENANCE_GUARD
        REGRESSION
    }
    unknown_or_missing_identity_action BLOCK
    vivado_invocation_allowed 0
    implementation_execution_allowed 0
    artifact_generation_allowed 0
    board_access_allowed 0
}
