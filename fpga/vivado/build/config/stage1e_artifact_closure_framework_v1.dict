validation_contract {
    schema_version stage1e-artifact-closure-validation-contract-v1
    required_suites {
        SCHEMA_CORRECTNESS
        IDENTITY_COMPLETENESS
        PROVENANCE_BINDING
        FAIL_CLOSED_BEHAVIOR
        POLICY_CONTRACT
        PROVENANCE_GUARD
