        "parent_role": {"type": "string", "enum": ["HOST_LAUNCHER", "ROOT_PROCESS", "DECLARED_SUPPORT_PROCESS"]},
        "minimum_count": {"type": "integer", "minimum": 0, "maximum": 32},
        "maximum_count": {"type": "integer", "minimum": 0, "maximum": 32}
