{
  "$schema": "stage1e-schema-subset-v1",
  "$id": "stage1e-runtime-host-process-instance-v1",
  "title": "Stage 1E host process-instance observation v1",
  "type": "object",
  "required": [
    "schema_version",
    "role",
    "pid",
    "parent_pid",
    "creation_time_utc",
    "observation_time_utc",
    "image_path",
    "image_state",
    "expected_image_state",
    "parent_state",
    "handle_state",
    "observation_handle_available",
    "job_membership",
    "job_event_sequences",
    "argument_observation_state",
    "cwd_observation_state",
    "first_seen_ordinal",
    "last_seen_ordinal",
    "exit_state",
    "exit_code",
    "authority_boundary"
  ],
  "additionalProperties": false,
  "x-stage1e-canonical-order": [
    "schema_version",
    "role",
    "pid",
    "parent_pid",
    "creation_time_utc",
    "observation_time_utc",
    "image_path",
    "image_state",
    "expected_image_state",
    "parent_state",
    "handle_state",
    "observation_handle_available",
    "job_membership",
    "job_event_sequences",
    "argument_observation_state",
    "cwd_observation_state",
    "first_seen_ordinal",
    "last_seen_ordinal",
    "exit_state",
    "exit_code",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "stage1e-runtime-host-process-instance-v1"},
    "role": {"type": "string", "enum": ["ROOT_PROCESS", "DECLARED_SUPPORT_PROCESS", "UNEXPECTED_DESCENDANT"]},
    "pid": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "parent_pid": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "creation_time_utc": {"$ref": "stage1e-runtime-host-common-v1#/$defs/token"},
    "observation_time_utc": {"$ref": "stage1e-runtime-host-common-v1#/$defs/token"},
    "image_path": {"$ref": "stage1e-runtime-host-common-v1#/$defs/path_or_none"},
    "image_state": {"type": "string", "enum": ["PRESENT", "UNAVAILABLE"]},
    "expected_image_state": {"type": "string", "enum": ["MATCHED", "MISMATCHED", "NOT_DECLARED", "UNAVAILABLE"]},
    "parent_state": {"type": "string", "enum": ["MATCHED", "MISMATCHED", "UNAVAILABLE", "ROOT_PARENT"]},
    "handle_state": {"type": "string", "enum": ["RETAINED", "OPENED_FOR_OBSERVATION", "UNAVAILABLE"]},
    "observation_handle_available": {"type": "boolean"},
    "job_membership": {"type": "string", "enum": ["IN_JOB", "NOT_IN_JOB", "UNKNOWN"]},
    "job_event_sequences": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "uniqueItems": true, "maxItems": 64},
    "argument_observation_state": {"type": "string", "enum": ["REQUEST_BOUND_ONLY", "OBSERVED_MATCHED", "OBSERVED_MISMATCHED", "UNAVAILABLE"]},
    "cwd_observation_state": {"type": "string", "enum": ["REQUEST_BOUND_ONLY", "OBSERVED_MATCHED", "OBSERVED_MISMATCHED", "UNAVAILABLE"]},
    "first_seen_ordinal": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "last_seen_ordinal": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "exit_state": {"type": "string", "enum": ["RUNNING", "EXITED", "UNAVAILABLE"]},
    "exit_code": {"$ref": "stage1e-runtime-host-common-v1#/$defs/integer_or_unavailable"},
    "authority_boundary": {"$ref": "stage1e-runtime-host-common-v1#/$defs/authority_boundary"}
  }
}
