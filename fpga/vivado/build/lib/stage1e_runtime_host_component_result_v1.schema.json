{
  "$schema": "stage1e-schema-subset-v1",
  "$id": "stage1e-runtime-host-component-result-v1",
  "title": "Stage 1E sealed terminal host component result v1",
  "type": "object",
  "required": [
    "schema_version",
    "result_state",
    "request_identity",
    "execution_id",
    "attempt_id",
    "runtime_backend_identity",
    "workspace_identity",
    "launcher_state",
    "terminal_status",
    "process_effect",
    "authorization_effect",
    "creation_attempt_count",
    "resume_count",
    "execution_process_limit",
    "root_process_id",
    "exit_code",
    "termination_disposition",
    "evidence_state",
    "heartbeat_final_cursor",
    "first_failure",
    "secondary_failures",
    "preflight_observation",
    "process_ledger",
    "process_event_journal",
    "timeout_termination_ledger",
    "timeout_event_journal",
    "heartbeat_journal",
    "stdout_capture",
    "stderr_capture",
    "vivado_component_result",
    "conflicts",
    "acceptance_decision",
    "authority_boundary"
  ],
  "additionalProperties": false,
  "x-stage1e-canonical-order": [
    "schema_version",
    "result_state",
    "request_identity",
    "execution_id",
    "attempt_id",
    "runtime_backend_identity",
    "workspace_identity",
    "launcher_state",
    "terminal_status",
    "process_effect",
    "authorization_effect",
    "creation_attempt_count",
    "resume_count",
    "execution_process_limit",
    "root_process_id",
    "exit_code",
    "termination_disposition",
    "evidence_state",
    "heartbeat_final_cursor",
    "first_failure",
    "secondary_failures",
    "preflight_observation",
    "process_ledger",
    "process_event_journal",
    "timeout_termination_ledger",
    "timeout_event_journal",
    "heartbeat_journal",
    "stdout_capture",
    "stderr_capture",
    "vivado_component_result",
    "conflicts",
    "acceptance_decision",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "stage1e-runtime-host-component-result-v1"},
    "result_state": {"type": "string", "const": "SEALED"},
    "request_identity": {"$ref": "stage1e-runtime-host-common-v1#/$defs/sha256"},
    "execution_id": {"$ref": "stage1e-runtime-host-common-v1#/$defs/token"},
    "attempt_id": {"$ref": "stage1e-runtime-host-common-v1#/$defs/token"},
    "runtime_backend_identity": {"$ref": "stage1e-runtime-host-common-v1#/$defs/sha256"},
    "workspace_identity": {"$ref": "stage1e-runtime-host-common-v1#/$defs/sha256"},
    "launcher_state": {"type": "string", "enum": ["LAUNCH_NOT_ATTEMPTED", "LAUNCH_FAILED", "PROCESS_EXITED", "PROCESS_TIMED_OUT", "PROCESS_OBSERVATION_LOST", "PROCESS_TERMINAL_STATE_UNKNOWN"]},
    "terminal_status": {"type": "string", "enum": ["COMPLETED", "FAILED", "BLOCKED"]},
    "process_effect": {"type": "string", "enum": ["NOT_STARTED", "EXITED_OBSERVED", "TERMINATED_BY_POLICY", "OBSERVATION_LOST", "STATE_UNKNOWN"]},
    "authorization_effect": {"type": "string", "enum": ["NOT_TOUCHED", "STATE_UNKNOWN"]},
    "creation_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "resume_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "execution_process_limit": {"type": "integer", "minimum": 1, "maximum": 32},
    "root_process_id": {"$ref": "stage1e-runtime-host-common-v1#/$defs/pid_or_unavailable"},
    "exit_code": {"$ref": "stage1e-runtime-host-common-v1#/$defs/integer_or_unavailable"},
    "termination_disposition": {"type": "string", "enum": ["NOT_REQUIRED", "NATURAL_EXIT", "GRACEFUL_EXIT", "FORCED_EXIT", "INCOMPLETE", "UNKNOWN"]},
    "evidence_state": {"type": "string", "enum": ["COMPLETE", "PARTIAL_PRESERVED", "UNAVAILABLE_WITH_REASON", "INTEGRITY_UNKNOWN"]},
    "heartbeat_final_cursor": {"$ref": "stage1e-runtime-host-process-ledger-v1#/$defs/heartbeat_cursor"},
    "first_failure": {"$ref": "stage1e-runtime-host-common-v1#/$defs/failure_or_none"},
    "secondary_failures": {"type": "array", "items": {"$ref": "stage1e-runtime-failure-record-v1#/$defs/failure_record"}, "maxItems": 64},
    "preflight_observation": {"$ref": "stage1e-runtime-host-common-v1#/$defs/evidence_file"},
    "process_ledger": {"$ref": "stage1e-runtime-host-common-v1#/$defs/evidence_file"},
    "process_event_journal": {"$ref": "stage1e-runtime-host-common-v1#/$defs/evidence_file"},
    "timeout_termination_ledger": {"$ref": "stage1e-runtime-host-common-v1#/$defs/evidence_file"},
    "timeout_event_journal": {"$ref": "stage1e-runtime-host-common-v1#/$defs/evidence_file"},
    "heartbeat_journal": {"$ref": "stage1e-runtime-host-common-v1#/$defs/evidence_file"},
    "stdout_capture": {"$ref": "stage1e-runtime-host-common-v1#/$defs/evidence_file"},
    "stderr_capture": {"$ref": "stage1e-runtime-host-common-v1#/$defs/evidence_file"},
    "vivado_component_result": {"$ref": "stage1e-runtime-host-common-v1#/$defs/evidence_file"},
    "conflicts": {"type": "array", "items": {"$ref": "stage1e-runtime-host-common-v1#/$defs/message"}, "uniqueItems": true, "maxItems": 64},
    "acceptance_decision": {"type": "string", "const": "NOT_OWNED"},
    "authority_boundary": {"$ref": "stage1e-runtime-host-common-v1#/$defs/authority_boundary"}
  }
}
